    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>3e41d10c-7281-43df-adfb-f41c085f1ab2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
